{
	"name": "transactly",
	"version": "2.1.5",
	"description": "Transactional Key Value Store based on CosmosDB.",
	"author": "Utily Contributors",
	"license": "MIT",
	"private": false,
	"repository": "https://github.com/utily/transactly",
	"bugs": {
		"url": "https://github.com/utily/transactly/issues"
	},
	"homepage": "https://github.com/utily",
	"type": "module",
	"module": "./dist/mjs/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"import": {
				"default": "./dist/mjs/index.js",
				"types": "./dist/types/index.d.ts"
			},
			"require": {
				"default": "./dist/cjs/index.js",
				"types": "./dist/types/index.d.ts"
			}
		}
	},
	"git": {
		"tagName": "v${version}"
	},
	"github": {
		"release": true
	},
	"scripts": {
		"lint": "eslint --max-warnings=0 '**/*.{ts,tsx}'",
		"fix": "eslint '**/*.{ts,tsx}' --fix",
		"build": "rimraf dist/* && tsc -p tsconfig.mjs.json && tsc -p tsconfig.cjs.json",
		"test": "vitest --run",
		"coverage": "vitest --coverage",
		"prepare": "npm run build",
		"clean": "rimraf dist node_modules coverage",
		"verify": "npm run build && npm run test && npm run lint && npm audit"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "2.2.2",
		"@types/service-worker-mock": "^2.0.1",
		"@typescript-eslint/eslint-plugin": "8.18.1",
		"@typescript-eslint/parser": "8.18.1",
		"@vitest/coverage-istanbul": "^2.1.8",
		"cloudly-http": "0.0.53",
		"cloudly-router": "0.0.26",
		"cloudflare-worker-local": "^1.13.0",
		"dotenv": "^8.2.0",
		"eslint": "^8.57.0",
		"eslint-plugin-prettierx": "github:utily/eslint-plugin-prettierx#utily-20231004",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"isomorphic-fetch": "^3.0.0",
		"prettierx": "github:utily/prettierx#utily-20231004",
		"rimraf": "^6.0.1",
		"service-worker-mock": "^2.0.5",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8"
	},
		"dependencies": {
		"@cfworker/cosmos": "^1.6.11",
		"cryptly": "3.1.3",
		"isoly": "2.0.30"
	}
}
